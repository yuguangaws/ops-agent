# To separate your traces from other application
LANGSMITH_PROJECT=new-agent

# Add API keys for connecting to LLM providers, data sources, and other integrations here
ZHIPUAI_API_KEY=xxxxxxxxxxxx
ZHIPUAI_DEFAULT_MODEL=glm-3-turbo

# MySQL 连接配置（mcp_server/tools/db.py 的 check_db 工具使用，默认值仅用于本地开发）
OPS_MYSQL_HOST=localhost
OPS_MYSQL_PORT=3306
OPS_MYSQL_USER=root
OPS_MYSQL_PASSWORD=xxxxxxxxxxxx
OPS_MYSQL_DATABASE=bi_test
